# Copy this file to .env and fill in real values. NEVER commit .env.

# --- Required ---------------------------------------------------------------
# PostgreSQL connection string (free options: Neon or Supabase).
# On Vercel use Neon's POOLED address here (the host contains "-pooler").
# Example shape: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=

# Optional: Neon's DIRECT address (without "-pooler"). Used only for database migrations. If empty, DATABASE_URL is used.
DIRECT_URL=

# Signs login sessions. At least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Encrypts students' e-GURO passwords in the database. Exactly 64 hex characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: if you lose or change this key, stored e-GURO passwords become unreadable and every student must reconnect.
ENCRYPTION_KEY=

# e-GURO website address
LMS_BASE_URL=https://lms.ccc.edu.ph

# --- Email (free: a dedicated Gmail account + app password) -------------------
# Gmail: turn on 2-Step Verification, then create an "App password" at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Shown as the sender, for example: e-GURO Companion <your.project.gmail@gmail.com>
MAIL_FROM=

# Public address of this app. REQUIRED once the site is online: confirm-email and reset-password links are built from it.
# Example: https://your-app.vercel.app   (no trailing slash)
APP_URL=

# Optional: a code classmates must type to sign up, so strangers cannot. Leave empty to let anyone with the address sign up.
INVITE_CODE=

# --- Owner alerts (optional) --------------------------------------------------
# Your address. When this is set, the checker emails you if many student checks fail in one run,
# or if e-GURO changes a page and the parser stops recognising the answer. Leave empty to turn alerts off.
# Alerts are sent through the same Gmail account as SMTP_USER above, and never contain student
# addresses, passwords or tokens (every detail is scrubbed before it is sent).
OWNER_ALERT_EMAIL=
# How many failed checks in ONE run trigger an alert.
# OWNER_ALERT_FAILURE_THRESHOLD=3
# How many "e-GURO changed its layout" errors in one run trigger an alert.
# OWNER_ALERT_FORMAT_THRESHOLD=1
# Smallest gap between two alerts of the same kind, so a broken site cannot flood the inbox.
# OWNER_ALERT_COOLDOWN_MINUTES=60

# --- Scheduled checker -------------------------------------------------------
# Secret that the scheduler sends to /api/cron/check. At least 16 characters. Generate like AUTH_SECRET.
CRON_SECRET=

# Optional tuning (defaults shown). Do not make the interval very short: it loads the college server.
# CHECK_INTERVAL_MINUTES=15
# MAX_USERS_PER_RUN=100
# DB_POOL_MAX=3
# CHECK_CONCURRENCY=3
# DELAY_BETWEEN_USERS_MS=500
