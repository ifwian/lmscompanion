// Prisma schema for e-GURO Companion.
// Every user-owned table has a userId column, and every query in the app filters by it.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ConnectionStatus {
  CONNECTED
  CHECKING
  AUTH_ERROR
  TEMPORARY_ERROR
  DISCONNECTED
}

enum ActivityType {
  ACTIVITY
  QUIZ
  ASSIGNMENT
  ANNOUNCEMENT
}

enum EmailStatus {
  PENDING // waiting to be sent
  SENT
  SKIPPED // user turned this notification type off
  FAILED // sending failed; the checker will retry a few times
}

model User {
  id                String   @id @default(uuid())
  name              String
  email             String   @unique // always stored lowercase
  passwordHash      String   @map("password_hash") // bcrypt hash, never the password
  passwordChangedAt DateTime? @map("password_changed_at") // sessions issued before this are rejected
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  lmsConnection           LmsConnection?
  notificationPreferences NotificationPreference?
  courses                 Course[]
  activities              Activity[]
  notifications           Notification[]

  @@map("users")
}

model LmsConnection {
  id                  String           @id @default(uuid())
  userId              String           @unique @map("user_id")
  lmsUsername         String           @map("lms_username")
  // AES-256-GCM encrypted LMS password (see lib/crypto.ts). Null after disconnect.
  encryptedPassword   String?          @map("encrypted_password")
  status              ConnectionStatus @default(CONNECTED)
  // Short code only (for example "AUTH_FAILED"). Never contains passwords or response bodies.
  lastErrorCode       String?          @map("last_error_code")
  consecutiveFailures Int              @default(0) @map("consecutive_failures")
  // false until the first successful sync. The first sync is a silent baseline (no emails).
  baselineDone        Boolean          @default(false) @map("baseline_done")
  lastSuccessfulLogin DateTime?        @map("last_successful_login")
  lastCheckedAt       DateTime?        @map("last_checked_at")
  nextCheckAt         DateTime?        @map("next_check_at")
  checkingStartedAt   DateTime?        @map("checking_started_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, nextCheckAt])
  @@map("lms_connections")
}

model Course {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  lmsCourseId String   @map("lms_course_id")
  courseCode  String?  @map("course_code")
  courseName  String   @map("course_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@unique([userId, lmsCourseId])
  @@map("courses")
}

model Activity {
  id            String       @id @default(uuid())
  userId        String       @map("user_id")
  courseId      String?      @map("course_id")
  // The id e-GURO gives the item (class_exam_id in the old prototype) and the raw type label.
  lmsActivityId String?      @map("lms_activity_id")
  lmsType       String?      @map("lms_type")
  // Stable duplicate-detection key: "lms:<type>:<id>" when e-GURO gives an id,
  // otherwise "hash:<sha256 of normalized fields>". Unique per user.
  fingerprint   String
  type          ActivityType
  title         String
  description   String?
  url           String?
  dueDate       DateTime?    @map("due_date")
  postedAt      DateTime?    @map("posted_at") // when e-GURO says the item was posted (from_date)
  // Current state, refreshed on every check:
  lmsStatus     String?      @map("lms_status") // ASSIGNED, DUE_TODAY or MISSED while it is pending; null otherwise
  isUnread      Boolean      @default(false) @map("is_unread") // currently in e-GURO's UNREAD list
  isMaterial    Boolean      @default(false) @map("is_material") // reading material (a lesson), not work to hand in
  lastSeenAt    DateTime?    @map("last_seen_at") // last check that still listed it
  detectedAt    DateTime     @default(now()) @map("detected_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  notification Notification?

  @@unique([userId, fingerprint])
  @@index([userId, detectedAt(sort: Desc)])
  @@index([userId, lmsStatus])
  @@map("activities")
}

model Notification {
  id               String      @id @default(uuid())
  userId           String      @map("user_id")
  activityId       String      @unique @map("activity_id") // one notification per activity
  notificationType ActivityType @map("notification_type")
  emailStatus      EmailStatus @default(PENDING) @map("email_status")
  emailSentAt      DateTime?   @map("email_sent_at")
  emailAttempts    Int         @default(0) @map("email_attempts")
  readAt           DateTime?   @map("read_at")
  createdAt        DateTime    @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([emailStatus])
  @@map("notifications")
}

model NotificationPreference {
  id                   String  @id @default(uuid())
  userId               String  @unique @map("user_id")
  activitiesEnabled    Boolean @default(true) @map("activities_enabled")
  quizzesEnabled       Boolean @default(true) @map("quizzes_enabled")
  assignmentsEnabled   Boolean @default(true) @map("assignments_enabled")
  announcementsEnabled Boolean @default(true) @map("announcements_enabled")
  // Stored for a future feature. Nothing sends daily emails.
  dailySummaryEnabled  Boolean @default(false) @map("daily_summary_enabled")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}
